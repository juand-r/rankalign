{
  "outputs_dir": "/datastor1/jdr/gv-gap/rankalign/outputs",
  "file_pattern": "scores_*.csv",
  "task_pattern": "plausibleqa-([a-z]+_\\d+)",
  "split_patterns": {
    "train": "_train_",
    "test": "_test_"
  },
  "label_column": "gpt4_ground_truth",
  "label_map": {"yes": 1, "no": 0},
  "gen_score_col": "gen_score",
  "val_score_col": "val_score",
  "base_pattern": "^scores_self-v6-google_gemma-2-2b_",
  "finetuned_pattern": "^scores_self-v6-google_gemma-2-2b-delta",
  "union_models": {
    "training_task": "plausibleqa-all",
    "eval_task_pattern": "(plausibleqa-[a-z]+_\\d+)_test"
  },
  "aggregation_groups": {
    "All PlausibleQA": "plausibleqa-*",
    "NQ": "plausibleqa-nq_*",
    "TriviaQA": "plausibleqa-trivia_*",
    "WebQ": "plausibleqa-webq_*"
  },
  "eval_columns": {
    "raw": "gen_score",
    "tc": "gen_score_typcorr",
    "lenorm": "gen_score_lenorm",
    "tc+lenorm": "gen_score_typcorr_lenorm"
  },
  "metrics": ["Val Acc", "Val ROC", "Gen ROC", "Correlation", "Corr-Pos", "Corr-Neg"],
  "visible_categories": ["Base", "S", "U"],
  "visible_modes": ["Comb", "SFT", "Pref"],
  "visible_flags": ["all", "labelonly", "semi", "tco", "tcneg", "norm", "v"]
}
